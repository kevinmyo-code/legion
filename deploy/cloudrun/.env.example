# Copy to `deploy/cloudrun/.env` before running deploy.py, deploy_job.py or
# install_schedule.py for real. `.env` is gitignored. This is CLOUD
# configuration, separate from `deploy/.env` (local compose/dev) on
# purpose: that file's ALLOWED_HOSTS=localhost and container-hostname
# DATABASE_URL are wrong for a deployed service, and this file never holds
# a secret value at all - SECRET_KEY and DATABASE_URL are Secret Manager
# references by name, created once with `gcloud secrets create` (see
# README.md), never written here.

# gcloud project id. Every script in this folder also accepts
# GOOGLE_CLOUD_PROJECT as a plain environment variable and that takes
# precedence if both are set; keeping it here too means one `.env` is the
# whole picture for a household that does not export shell variables.
GOOGLE_CLOUD_PROJECT=

# Dallas, close to Houston, so the cold-start network hop is short.
# us-central1 (Iowa) is the other free-tier-friendly option if this region
# is ever unavailable for a resource this project needs.
CLOUD_RUN_REGION=us-south1

# Comma-separated hostnames the deployed service answers to. Left blank
# until the first deploy tells you the *.run.app URL; fill it in and
# redeploy. Add the Cloudflare-fronted domain once DNS points at it.
ALLOWED_HOSTS=

# Comma-separated, scheme included, e.g. https://legion.example.com,
# https://legion-xxxxx-uc.a.run.app
CSRF_TRUSTED_ORIGINS=

# Cloud Run's filesystem is ephemeral - this is scratch space, not
# durable storage, until ticket 05's R2/GCS-backed media lands.
MEDIA_ROOT=/tmp/legion-media

DJANGO_DEBUG=false

# A runaway bill is impossible only if something enforces it. This caps
# concurrent service instances; deploy_job.py's Job has its own,
# separate --max-retries/--task-timeout limits instead, since a Job does
# not have "instances" the way a service does.
CLOUD_RUN_MAX_INSTANCES=4
