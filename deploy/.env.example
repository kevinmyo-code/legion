# Copy to `.env` in this same directory before running compose or `manage.py`
# locally. `.env` is gitignored. `legion/settings.py` refuses to start if any
# of these is missing - no value here is ever a real default.

# Which docker-compose.yml services a bare `docker compose up` starts. Full
# stack (postgres, web, worker, caddy) by default, so a fresh clone with no
# further edits matches ADR 0044's "clone, docker compose up, make two
# users, point the app at the URL." Kevin's own dev loop overrides this for
# one shell rather than editing the file:
#   COMPOSE_PROFILES= docker compose --profile local up
# See the comment at the top of docker-compose.yml for why the override has
# to blank this rather than just adding --profile local on top of it.
COMPOSE_PROFILES=full

# Django's cryptographic secret. Generate one per install, never share it
# across households:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# "true" or "false". No default: a household must decide, not inherit one.
DJANGO_DEBUG=false

# Comma-separated hostnames this server answers to, e.g. legion.example.com,
# legion-xxxxx-uc.a.run.app for the Cloud Run URL itself.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated, scheme included, e.g. https://legion.example.com -
# CSRF's trusted-origin check wants the scheme and ALLOWED_HOSTS does not
# carry one. Optional: local dev never hits a CSRF-protected form (device
# token header, not a session cookie), so it is fine to leave this empty.
CSRF_TRUSTED_ORIGINS=

# postgres://user:password@host:port/dbname
# Inside compose, host is the `postgres` service name; for a bare
# `manage.py runserver` against the fallback local Postgres, use localhost.
DATABASE_URL=postgres://legion:legion@postgres:5432/legion

# Where uploaded media (receipts, statements, recordings) lands on disk.
# Compose mounts a named volume here; a bare-metal run can point anywhere
# writable.
MEDIA_ROOT=/app/media

# Read by the `postgres` service itself, not by Django - kept alongside the
# rest so one file is the whole picture.
POSTGRES_USER=legion
POSTGRES_PASSWORD=legion
POSTGRES_DB=legion
