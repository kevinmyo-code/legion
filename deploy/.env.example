# Copy to `.env` in this same directory before running compose or `manage.py`
# locally. `.env` is gitignored. `legion/settings.py` refuses to start if any
# of these is missing - no value here is ever a real default.

# Which docker-compose.yml services a bare `docker compose up` starts. Full
# stack (postgres, web, worker, caddy) by default, so a fresh clone with no
# further edits matches ADR 0044's "clone, docker compose up, make two
# users, point the app at the URL." Kevin's own dev loop overrides this for
# one shell rather than editing the file:
#   COMPOSE_PROFILES= docker compose --profile local up
# See the comment at the top of docker-compose.yml for why the override has
# to blank this rather than just adding --profile local on top of it.
COMPOSE_PROFILES=full

# Django's cryptographic secret. Generate one per install, never share it
# across households:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# "true" or "false". No default: a household must decide, not inherit one.
DJANGO_DEBUG=false

# Comma-separated hostnames this server answers to, e.g. legion.example.com,
# legion-xxxxx-uc.a.run.app for the Cloud Run URL itself.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated, scheme included, e.g. https://legion.example.com -
# CSRF's trusted-origin check wants the scheme and ALLOWED_HOSTS does not
# carry one. Optional: local dev never hits a CSRF-protected form (device
# token header, not a session cookie), so it is fine to leave this empty.
CSRF_TRUSTED_ORIGINS=

# postgres://user:password@host:port/dbname
# Inside compose, host is the `postgres` service name; for a bare
# `manage.py runserver` against the fallback local Postgres, use localhost.
DATABASE_URL=postgres://legion:legion@postgres:5432/legion

# ADR 0045 (households are tenants): the uuid of the FIRST household on this
# engine. The households-are-tenants migration puts every existing row and
# every existing member in it, so it is the id every backfilled row will carry
# in every environment this database is ever restored into. Choose it ONCE and
# keep it - the migration refuses to run rather than mint a random one nobody
# wrote down.
#   python -c "import uuid; print(uuid.uuid4())"
LEGION_BOOTSTRAP_HOUSEHOLD_ID=

# What that household is called. Optional; "Home" if unset.
LEGION_BOOTSTRAP_HOUSEHOLD_NAME=Home

# ADR 0045 decision 3: signup is INVITE-ONLY unless this is on. Leave it
# unset (the default, and the only safe one) and the only way to get an
# account on this engine is a code an owner minted. Set it to "true" and
# `POST /api/auth/signup` also accepts a request with no invite code, and
# founds a household for it - which is what a stranger's own compose stack
# wants for its very first account. A request that DOES carry a code is
# honoured either way, so the second adult still joins the first one's
# household rather than founding a rival.
LEGION_OPEN_SIGNUP=

# Where uploaded media (receipts, statements, recordings) lands on disk.
# Compose mounts a named volume here; a bare-metal run can point anywhere
# writable.
MEDIA_ROOT=/app/media

# Read by CADDY, not by Django (tickets 09 and 12, the move to the Oracle
# VM), which is why `legion/settings.py` has no `required_env` for either
# and why the `caddy` service in docker-compose.yml carries `env_file: .env`.

# The hostname the household reaches the engine at, WITHOUT a scheme -
# `legion.example.com`, not `https://legion.example.com`. Caddy uses it as the
# site address in `deploy/Caddyfile`, which is what makes it issue and renew a
# Let's Encrypt certificate for that name.
#
# Leave it EMPTY for a LAN or bare-IP install: the Caddyfile falls back to `:80`
# and serves plain HTTP under any hostname, which is what this stack did before
# the variable existed. Verified both ways with `caddy validate`, 2026-09-08.
#
# Setting this is not the whole job. The name also has to appear in
# `ALLOWED_HOSTS` above, and `https://<name>` in `CSRF_TRUSTED_ORIGINS`, or
# Django rejects every request with DisallowedHost while Caddy looks perfectly
# healthy in front of it. Ticket 13 step 2 has the full sequence, DNS included.
LEGION_DOMAIN=

# The ACME contact address Caddy registers with Let's Encrypt. Used for expiry
# and policy notices; a certificate issues without it, so this may be left
# empty (the Caddyfile quotes the substitution precisely so an empty value is
# not a startup error - measured, an UNQUOTED empty one is).
#
# Worth filling in on a box nobody watches daily: with an address, Caddy also
# configures ZeroSSL as a fallback issuer, so a Let's Encrypt outage during a
# renewal window is survivable. With none, Let's Encrypt is the only issuer.
LEGION_ACME_EMAIL=

# Read by the `postgres` service itself, not by Django - kept alongside the
# rest so one file is the whole picture.
POSTGRES_USER=legion
POSTGRES_PASSWORD=legion
POSTGRES_DB=legion
