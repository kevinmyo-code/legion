<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy auto-backup rules (API 30 and below). Same intent as
  data_extraction_rules.xml: exclude the credential-bearing prefs
  (companion_profile.xml = Gemini key + Shelly Cloud auth_key,
  incl. their plaintext Keystore-failure fallback slots, + spend passphrase
  hash) so they never land in a device backup. Everything else backs up
  normally.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="companion_profile.xml" />
    <!-- One OBD adapter, moved between cars: which car it is in, and each car's learned print, stay on this phone. -->
    <exclude domain="sharedpref" path="car_fingerprint.xml" />
    <exclude domain="sharedpref" path="dongle_car.xml" />
    <!-- The car link: the head unit link keys (Keystore-sealed) and its switches stay on this phone. -->
    <exclude domain="sharedpref" path="car_link.xml" />
    <!-- ADR 0080: files a Claude task brought to the phone (a scan may be an ID). -->
    <exclude domain="file" path="claude_files/" />
    <!-- Recordings of his voice stay on the phone: never in a backup. -->
    <exclude domain="external" path="voice-turns/" />
    <exclude domain="external" path="wake-samples/" />
    <!-- "Only my voice": the voiceprint built from his voice never leaves the phone. -->
    <exclude domain="file" path="voiceprint/" />
</full-backup-content>
