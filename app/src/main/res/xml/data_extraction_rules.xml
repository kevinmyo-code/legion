<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup / device-transfer rules (Android 12+ / API 31+). With
  android:allowBackup="true", everything is backed up unless excluded here.

  companion_profile.xml holds all credential material - the BYO Gemini API key,
  Mapbox token, and Shelly Cloud auth_key (each stored KeyVault-encrypted, but
  with a plaintext fallback slot used when the device's Keystore is broken)
  plus the spend-gate passphrase hash. We exclude that whole prefs file from
  both cloud backup and
  device transfer so a plaintext-fallback key can never leave the device in a
  backup. The encrypted blobs would be useless off-device anyway (their
  Keystore key never leaves the device), so nothing of value is lost - the
  driver just re-pastes their key after a restore/transfer. Trade-off: the
  companion's name/persona live in this same file and won't restore either; if
  persona-restore is ever wanted, split credentials into their own prefs file
  and exclude only that.

  Everything else (settings, nav preference, OBD registry, logbook DB) still
  backs up normally.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="companion_profile.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="companion_profile.xml" />
    </device-transfer>
</data-extraction-rules>
