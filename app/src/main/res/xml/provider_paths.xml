<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider path configuration for CameraCapture's camera-app handoff URI, and for the
    Claude session's delivered files (ADR 0080).
    The "cache-path" element exposes context.cacheDir so FileProvider can
    produce content:// URIs for the temporary JPEG written there.
-->
<paths>
    <cache-path name="shared_images" path="." />
    <!-- Files to phone (ADR 0080): a Claude task's delivered files, app-private, handed to a
         viewer or the share sheet one read-only grant at a time (claude/ClaudeFileIntents.kt). -->
    <files-path name="claude_files" path="claude_files/" />
</paths>
