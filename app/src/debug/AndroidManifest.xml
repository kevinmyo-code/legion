<?xml version="1.0" encoding="utf-8"?>
<!--
  THROWAWAY prototype manifest overlay, debug build type only - never merged into a release
  build, so `PrototypeDashboardActivity` cannot ship. This is the answer to aspect-engine ticket
  09 ("Dashboard grid mechanics: staged prototype"): a spike to let Kevin react on the A25, not
  a shipped screen. Delete this whole overlay (this file + prototype/) once the ticket resolves,
  whichever way the answer lands.

  Launch from the phone with:
    adb shell am start -n com.kevin.legion/.prototype.PrototypeDashboardActivity
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- DEBUG BUILD TYPE ONLY - see res/xml/network_security_config.xml (this source set) for
         why and for the scope this permits. Manifest merger applies a source set's own
         AndroidManifest.xml only to builds of that build type, so this attribute is absent from
         any release manifest; verified by inspecting the merged release manifest rather than
         assumed (backend-erp / laptop-engine cleartext ticket, 2026-09-05). -->
    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- The widget pager's own debug export DELETED (cutover 5,
             docs/architecture/cutover5-2026-08-24.md) - WidgetPagerActivity itself is gone, the
             pager is reached through MainActivity (already exported, already launcher) now.
             MirrorSyncActivity keeps its own debug export below - untouched by this cutover. -->
        <activity
            android:name=".ui.mirror.MirrorSyncActivity"
            android:exported="true"
            tools:replace="android:exported" />
        <activity
            android:name=".prototype.PrototypeDashboardActivity"
            android:exported="true"
            android:label="LEGION Prototype: Dashboard Grid"
            android:theme="@style/Theme.Legion">
            <!-- No LAUNCHER category on purpose - this must not appear on the home screen
                 next to the real app icon. adb am start is the intended way in. -->
        </activity>
    </application>
</manifest>
