# Build artifacts / caches
*.apk
*.aab
.kotlin/
/.idea/

# Signing key - personal sideload keystore, never commit
app/release.jks
*.jks
*.keystore

# Firebase config - not set up yet for this project (fresh Firebase project
# needed, see README). Never commit a real google-services.json.
app/google-services.json

# OS / editor
Thumbs.db

# Scratch working state. Disposable by default, EXCEPT wayfinder maps, tickets
# and research findings, which are tracked.
#
# This used to be a blanket `.scratch/`. That convention destroyed a 15-ticket
# wayfinder map with twelve unresolved contested calls in the 2026-07-31 machine
# port, because the directory was gitignored, never committed, and nothing had
# been filed to memory/library yet. "Disposable" was true of the churn and false
# of the map. Decisions still get filed to memory/library/decisions.md as they
# are made - that rule is unchanged and is the durable record. This just stops
# the in-flight state from being one `rm -rf` away from gone.
.scratch/**
!.scratch/
!.scratch/*/
!.scratch/*/map.md
!.scratch/*/issues/
!.scratch/*/issues/**
!.scratch/*/research/
!.scratch/*/research/**
!.scratch/*/*.canvas

# Background-agent worktree scratch space
.claude/worktrees/

# Per-machine tool permissions. The shared agent defs in .claude/agents/ ARE committed.
.claude/settings.local.json

# Vosk wake-word model: fetched locally per app/src/main/assets/vosk-model/README.md,
# never committed. The binary is gitignored, not the source set.
app/src/main/assets/vosk-model/*
!app/src/main/assets/vosk-model/README.md

# Personal Midnight AI import bundle (real vehicle/location data, ends up inside
# the APK). Generated by tools/export_midnight_ai.py. Never commit - repo is public.
app/src/main/assets/midnight_import/
# Moved to a debug-only source set 2026-08-17 so a release APK structurally cannot
# package it (app/build.gradle.kts explains why a packaging filter was rejected).
app/src/debug/assets/midnight_import/

# Obsidian: share the vault config, not the per-machine window layout
.obsidian/workspace*.json
.obsidian/appearance.json
.obsidian/cache
.obsidian/plugins/
.obsidian/themes/
