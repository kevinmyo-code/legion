# Normalize line endings: store LF in the repo, check out native on each OS.
* text=auto

# Keep shell/gradle wrapper scripts as LF.
gradlew text eol=lf
*.sh text eol=lf

# Windows scripts as CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.apk binary
*.aab binary
*.ttf binary
*.otf binary
