<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy auto-backup rules (API 30 and below). Same intent as
  data_extraction_rules.xml: exclude the credential-bearing prefs
  (companion_profile.xml = Gemini key + Shelly Cloud auth_key,
  incl. their plaintext Keystore-failure fallback slots, + spend passphrase
  hash) so they never land in a device backup. Everything else backs up
  normally.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="companion_profile.xml" />
</full-backup-content>
