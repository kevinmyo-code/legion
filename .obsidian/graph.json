{
  "collapse-filter": false,
  "search": "-path:\"app/src\" -path:\".claude\"",
  "showTags": true,
  "showAttachments": false,
  "hideUnresolved": true,
  "showOrphans": false,
  "collapse-color-groups": false,
  "colorGroups": [
    { "query": "tag:#map", "color": { "a": 1, "rgb": 14701138 } },
    { "query": "tag:#ticket status:open", "color": { "a": 1, "rgb": 5431378 } },
    { "query": "tag:#ticket", "color": { "a": 1, "rgb": 8355711 } },
    { "query": "tag:#library", "color": { "a": 1, "rgb": 5750759 } }
  ],
  "collapse-display": false,
  "showArrow": true,
  "textFadeMultiplier": -0.8,
  "nodeSizeMultiplier": 1.2,
  "lineSizeMultiplier": 1,
  "collapse-forces": false,
  "centerStrength": 0.5,
  "repelStrength": 12,
  "linkStrength": 1,
  "linkDistance": 180,
  "scale": 0.6
}
