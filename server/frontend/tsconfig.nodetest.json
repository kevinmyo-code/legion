{
  // Tests that run in Node (`*.node.test.ts`: they read fixture files). Their own project, so the
  // app's program never sees Node's types (they change what `setTimeout` returns everywhere).
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.nodetest.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["node", "vite/client", "vitest/globals"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.node.test.ts"]
}
