# Restored by `npm ci` from the committed `package-lock.json`.
node_modules

# The build lands in `../static/app` (see `vite.config.ts`), which
# `server/.gitignore` covers. `dist` is only ever produced by `vite preview`
# defaults or a mistyped outDir; ignored so neither can be committed by accident.
dist
dist-ssr
*.local

