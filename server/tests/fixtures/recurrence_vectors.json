      "series": {
        "starts_at": "2026-08-01T00:00:00Z",
        "repeat_kind": "DAILY",
        "repeat_every": 1,
        "repeat_days_of_week": null,
        "repeat_day": null,
        "repeat_month": null,
        "repeat_end_kind": "NEVER",
        "repeat_end_date": null,
        "repeat_end_count": null
      },
      "skips": [],
