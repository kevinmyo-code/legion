# Normalize line endings: store LF in the repo, check out native on each OS.
* text=auto

# Keep shell/gradle wrapper scripts as LF.
gradlew text eol=lf
*.sh text eol=lf

# Generated by `server/manage.py write_openapi` and compared line-for-line by
# its staleness test (`server/tests/test_openapi_schema.py`). The generator
# writes LF; without this the file would be checked out CRLF on Windows and
# the test would read as permanently stale on a fresh clone.
server/openapi.yaml text eol=lf

# Windows scripts as CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never touch. Git's own binary auto-detection already
# protects these (verified byte-for-byte against the ledger PDF fixtures,
# .claude/plans/wiggly-beaming-quasar.md), but don't rely on a heuristic
# alone for financial test data.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.apk binary
*.aab binary
*.aar binary
*.ttf binary
*.otf binary
*.pdf binary
